#!/usr/bin/env python3
"""Build the exact Level03 type-1 row-6 discriminator under work/."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import stat
import sys


REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT / "reimplementation"))

from ablpc.level03_type1_row_mod import (  # noqa: E402
    Level03Type1RowModError,
    build_level03_type1_row6_x_plus_128,
)


def _is_within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Build the exact-hash Level03 type-1 row-6 X+128 discriminator. "
            "Both paths must remain under this repository's work/ tree."
        )
    )
    parser.add_argument("source", type=Path, help="exact retail LEVEL03/LEVEL.DAT")
    parser.add_argument("output", type=Path, help="fresh output path under work/")
    args = parser.parse_args()

    work_root = (REPO_ROOT / "work").resolve()
    source = args.source
    output = args.output
    source_resolved = source.resolve()
    output_resolved = output.resolve()

    if not _is_within(source_resolved, work_root):
        parser.error("source must be a derived copy under work/")
    if not _is_within(output_resolved, work_root):
        parser.error("output must be under work/")
    if source.is_symlink() or not source.is_file():
        parser.error("source must be an existing regular non-link file")
    if output.exists() or output.is_symlink():
        parser.error("output must not already exist")
    if source_resolved == output_resolved:
        parser.error("source and output must differ")

    try:
        result = build_level03_type1_row6_x_plus_128(source.read_bytes())
    except (OSError, Level03Type1RowModError) as exc:
        parser.error(str(exc))

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(result.output_bytes)
    os.chmod(output, stat.S_IMODE(source.stat().st_mode))

    receipt = dict(result.receipt)
    receipt["source_path"] = str(source)
    receipt["output_path"] = str(output)
    print(json.dumps(receipt, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
