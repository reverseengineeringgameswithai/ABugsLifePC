#!/usr/bin/env python3
"""Build the exact duplicate-FLIK Training DAT from a user-owned work copy."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "reimplementation"))

from ablpc.training_letter_mod import (  # noqa: E402
    TrainingLetterModError,
    build_training_duplicate_flik,
)


def _within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Build the exact PC TRAINING duplicate-FLIK LEVEL1.DAT recipe."
    )
    parser.add_argument(
        "source",
        type=Path,
        help="exact accepted 51-grain Training LEVEL1.DAT under work/copies",
    )
    parser.add_argument("output", type=Path, help="new output under work/copies")
    args = parser.parse_args()

    copies_root = (ROOT / "work" / "copies").resolve()
    source = args.source.resolve()
    output_argument = args.output
    if output_argument.is_symlink():
        parser.error(f"refusing linked output: {output_argument}")
    output = output_argument.resolve()
    if not _within(source, copies_root) or not _within(output, copies_root):
        parser.error("source and output must both be below work/copies/")
    if source == output:
        parser.error("source and output must be different paths")
    if not source.is_file():
        parser.error(f"source is not a regular file: {source}")
    if output.exists():
        parser.error(f"refusing to overwrite existing output: {output}")
    if not output.parent.is_dir():
        parser.error(f"output parent directory does not exist: {output.parent}")

    try:
        result, receipt = build_training_duplicate_flik(source.read_bytes())
        output.write_bytes(result)
    except (OSError, TrainingLetterModError, ValueError) as error:
        parser.error(str(error))
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
