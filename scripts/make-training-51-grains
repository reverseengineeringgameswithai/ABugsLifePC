#!/usr/bin/env python3
"""Build the exact validated TRAINING 51-grain DAT from a user-owned copy."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "reimplementation"))

from ablpc.training_grain_mod import TrainingGrainModError, build_training_51_grains


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Build the exact PC TRAINING 51-grain LEVEL1.DAT recipe."
    )
    parser.add_argument("source", type=Path, help="exact retail TRAINING LEVEL1.DAT")
    parser.add_argument("output", type=Path, help="new output path under work/")
    args = parser.parse_args()

    source = args.source.resolve()
    output = args.output.resolve()
    if source == output:
        parser.error("source and output must be different paths")
    if output.exists() or output.is_symlink():
        parser.error(f"refusing to overwrite output: {output}")
    try:
        result, receipt = build_training_51_grains(source.read_bytes())
    except (OSError, TrainingGrainModError, ValueError) as error:
        parser.error(str(error))

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(result)
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
