#!/usr/bin/env bash
# Refuse a push whose commits contain a name from the local, unpushed
# .git/info/private-names: file contents in plain, UTF-16, hex or base64 form,
# paths, messages and identities. See scripts/git-hooks/private_names.py.
# Without the list file the push is allowed.
exec python3 "$(git rev-parse --show-toplevel)/scripts/git-hooks/private_names.py" push
